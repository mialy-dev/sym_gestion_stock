{% extends 'base.html.twig' %}


{% block content %}
    <h1>Type</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ ttype.id }}</td>
            </tr>
            <tr>
                <th>Type</th>
                <td>{{ ttype.type }}</td>
            </tr>
        </tbody>
    </table>

    <a class="btn btn-outline-warning" href="{{ path('app_type_index') }}">Retour aux listes</a>

    <a class="btn btn-outline-success" href="{{ path('app_type_edit', {'id': ttype.id}) }}">Modifier</a>

    {{ include('type/_delete_form.html.twig') }}
{% endblock %}
