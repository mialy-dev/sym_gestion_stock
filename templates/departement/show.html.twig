{% extends 'base.html.twig' %}


{% block content %}
    <h1>Departement</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ tdepartement.id }}</td>
            </tr>
            <tr>
                <th>Departement</th>
                <td>{{ tdepartement.departement }}</td>
            </tr>
        </tbody>
    </table>

    <a class="btn btn-outline-info" href="{{ path('app_departement_index') }}">Retour aux listes</a>
    {{ include('departement/_delete_form.html.twig') }}
    <a class="btn btn-outline-success" href="{{ path('app_departement_edit', {'id': tdepartement.id}) }}">Modifier</a>

    
{% endblock %}
