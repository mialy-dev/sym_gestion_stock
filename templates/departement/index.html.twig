{% extends 'base.html.twig' %}


{% block content %}
    <h1>Departement</h1>
    <a href="{{ path('app_departement_new') }}" class="btn btn-outline-warning">Créer à nouveau</a>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Departement</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for tdepartement in tdepartements %}
            <tr>
                <td>{{ tdepartement.id }}</td>
                <td>{{ tdepartement.departement }}</td>
                <td>
                    <a href="{{ path('app_departement_show', {'id': tdepartement.id}) }}" class="btn btn-outline-success" >Voir</a>
                    <a href="{{ path('app_departement_edit', {'id': tdepartement.id}) }}" class="btn btn-outline-danger" >Modifier</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

  
{% endblock %}
