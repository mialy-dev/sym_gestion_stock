{% extends "base.html.twig" %}
{% block content %}

	<div class="col-md-12">
		<div class="card">
			<div class="card-header">
				<h5>Listes des Etudiant</h5>
				<br>
				<br>
				<a class="btn btn-primary" href="{{ path('app_etudiant') }}">Nouveau</a>

			</div>
			<div class="card-body table-border-style">
				<div class="table-responsive">
					<table class="table table-dark">
						<thead>
							<tr>
								<th>Nom</th>
								<th>Prénom</th>

								<th>Matricule</th>
								<th>Classe</th>
								<th></th>
							</tr>
						</thead>
						<tbody>
							{% for listes in listes %}
								<tr>
									<td>{{ listes.nom }}</td>
									<td>{{ listes.prenom }}</td>
									<td>{{ listes.matricule }}</td>

									<td>{{ listes.getIdClasse().getclasse }}</td>
									<td></td>
								</tr>
							{% endfor %}

						</tbody>
					</table>
				</div>
			</div>
		</div>
	</div>

{% endblock %}
