{% extends "base.html.twig" %}
{% block content %}

<form method="POST">
	<div class="row">
		<div class="col-md-6">

			<div class="form-group">
				<label for="exampleInputEmail1">Nom</label>
				<input type="text" class="form-control" name="nom" id="exampleInputEmail1">
			</div>
			<div class="form-group">
				<label for="exampleInputPassword1">Prenom</label>
				<input type="text" class="form-control" name="prenom">
			</div>
			<button type="submit" class="btn  btn-primary" name="enregistrer">Enregistrer</button>
			<br><br>
			<a class="btn btn-info w-50" href="{{ path('app_etudiant_liste') }}">Listes des etudiants</a>
		</div>
		<div class="col-md-6">
			<div class="form-group">
				<label for="exampleInputPassword1">Matricule</label>
				<input type="number" class="form-control" name="matricule">
			</div>
			<div class="form-group">
				<label for="exampleFormControlSelect1">Classe</label>
				<select class="form-control" id="exampleFormControlSelect1" name="classe">
					{% for listeC in listeC %}
						<option value="{{ listeC.id }}">{{ listeC.classe }}</option>
					{% endfor %}
				</select>
			</div>
		</div>
	</div>
</form>

{% endblock %}

