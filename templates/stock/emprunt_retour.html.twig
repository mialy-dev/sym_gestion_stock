{% extends "base.html.twig" %}
{% block content %}

	<div class="col-md-12">
		<div class="card">
			<div class="card-header">
				<h5>Listes des Stocks</h5>
				<br>
				<br>

			</div>
			<div class="card-body table-border-style">
				<div class="table-responsive">
					<table class="table table-dark">
						<thead>
							<tr>
								<th>Designation</th>
								<th>Famille</th>
								<th>Type</th>
								<th>Identification</th>
                                <th>Quantité</th>
                                <th>Unité</th>
                                <th>Date</th>
                                <th>action</th>
							</tr>
						</thead>
						<tbody>
							{% for listes in listes %}
								<tr>
									<td>{{ listes.designation }}</td>
									<td>{{ listes.getIdFamille().famille }}</td>
									<td>{{ listes.getIdType().type }}</td>
                                    <td>{{ listes.identification }}</td>
                                    <td>{{ listes.quantite }}</td>
                                    <td>{{ listes.getIdUnite().unite }}</td>
                                    <td>{{ listes.getDateEntrer()|date('d/m/Y') }}</td>
                                    <td>
										<a href="{{ path('app_stock_listes_emprunt_produit',{id:listes.id}) }}" class="btn btn-primary">emprunter</a>
									</td>
								</tr>
							{% endfor %}

						</tbody>
					</table>
				</div>
			</div>
		</div>
	</div>

{% endblock %}
