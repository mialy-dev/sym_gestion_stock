{% extends 'base.html.twig' %}


{% block content %}
<form method="POST">
    <div class="mb-3">
        <label for="exampleFormControlInput1" class="form-label">Personnel</label>
        <select class="form-control" aria-label="Default select example" name="personnel">
            {% for listes in listes %}
            <option value="{{ listes.id }}">{{ listes.nom }} {{ listes.prenom }}</option>
            {% endfor %}
        </select>

        <label for="exampleFormControlInput1" class="form-label">Quantite livrer</label>
        <input type="number" class="form-control" id="exampleFormControlInput1" name="qtel">

        <label for="exampleFormControlInput1" class="form-label">Date de livraison</label>
        <input type="date" class="form-control" id="exampleFormControlInput1" name="datel">

        <label for="exampleFormControlInput1" class="form-label">quantite demande</label>
        <input type="number" class="form-control" id="exampleFormControlInput1" name="qted">

        <label for="exampleFormControlInput1" class="form-label">instruction</label>
        <input type="text" class="form-control" id="exampleFormControlInput1" name="instruction">

        <label for="exampleFormControlInput1" class="form-label">reste</label>
        <input type="text" class="form-control" id="exampleFormControlInput1" name="reste">

    </div>
    <button type="submit" class="btn btn-success" name="enregistrer">Enregistrer</button>
    <br><br>
    <a class="btn btn-info w-50" href="">Listes des emprunts</a>
</form>
{% endblock %}
