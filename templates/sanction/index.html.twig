{% extends "base.html.twig" %}
{% block content %}

	<form method="POST">
		<div class="row">
			<div class="col-md-6">

				<div class="form-group">
					<label for="exampleInputPassword1">Etudiant </label>
					<select name="etudiant" class="form-control">
                        <option >---------------------</option>
                        {% for listeE in listeE %}
                            <option value="{{listeE.id}}">{{ listeE.nom }} {{ listeE.prenom }}</option>
                        {% endfor %}
                    </select>
				</div>

				
				<div class="form-group">
					<label for="exampleInputPassword1">Date </label>
					<input type="date" class="form-control" name="date">
				</div>
				<div class="form-group">
					<label for="exampleInputPassword1">Heure </label>
					<input type="time" class="form-control" name="heure_sanction">
				</div>
				<div class="form-group">
					<label for="exampleInputPassword1">Durée </label>
					<input type="text" class="form-control" name="duree">
				</div>
                <div class="form-group">
					<label for="exampleInputPassword1">Motif </label>
					<input type="text" class="form-control" name="motif">
				</div>
                <div class="form-group">
					<label for="exampleInputPassword1">Personnel </label>
					<select name="personnel" class="form-control">
                        <option >---------------------</option>
						{% for listeP in listeP %}
						<option value="{{ listeP.id }}">{{ listeP.nom }} {{ listeP.prenom }}</option>
					{% endfor %}
                    </select>
				</div>
				<button type="submit" class="btn  btn-primary" name="enregistrer">Enregistrer</button>
				<br><br>
				<a class="btn btn-info w-50" href="{{ path('app_sanction_listes') }}">Listes des sanctions</a>
			</div>
		</div>
	</form>

{% endblock %}
