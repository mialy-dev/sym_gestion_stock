{% extends "base.html.twig" %}
{% block content %}
    {{ form_start(form) }}
    <div class="row">
        <div class="col-12">
            <div class="form-group">
             {{ form_row(form.date_sanction) }}
            </div>
            <div class="form-group">
                {{ form_row(form.heure_sanction)}}
            </div>
            <div class="form-group">
                {{ form_row(form.duree)}}
            </div>
            <div class="form-group">
                {{ form_row(form.motif)}}
            </div>
        </div>
        <button type="submit" class="btn  btn-primary" name="enregistrer">Enregistrer</button>
    </div>
    {{ form_end(form) }}
{% endblock %}