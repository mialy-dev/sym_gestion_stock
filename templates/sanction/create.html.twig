{% extends "base.html.twig" %}
{% block content %}
    {{ form_start(form) }}
    <div class="row">
        <div class="col-12">
            <div class="form-group">
             {{ form_row(form.date_sanction) }}
            </div>
            <div class="form-group">
                {{ form_row(form.heure_sanction)}}
            </div>
            <div class="form-group">
                {{ form_row(form.duree)}}
            </div>
            <div class="form-group">
                {{ form_row(form.motif)}}
            </div>
            <div class="form-group">
                {{ form_row(form.etudiant)}}
            </div>
        </div>
        <button type="submit" class="btn  btn-primary ml-3" name="enregistrer">Enregistrer</button>
    </div>
    {{ form_end(form) }}
{% endblock %}

{% block script  %}
    <script>
        const allSelecter = document.querySelectorAll("select");
        allSelecter.forEach((select)=>{
            select.removeAttribute("multiple");
        });
    </script>
{% endblock %}